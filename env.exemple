# Auth Secret
AUTH_SECRET= YourAuthSecretHere
# Entra External ID
AUTH_ENTRA_CLIENT_ID= YourClientIDHere
AUTH_ENTRA_CLIENT_SECRET= YourClientSecretHere
AUTH_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>
AUTH_ENTRA_END_SESSION_ENDPOINT=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/oauth2/v2.0/logout
# MSAL Redirect URI
MSAL_REDIRECT_URI=https://localhost:3001/api/v1/auth/callback